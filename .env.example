# ==========================================
# EduRAG AI - Environment Configuration
# ==========================================

# Active Model Provider (options: 'demo', 'ollama', 'gemini', 'openai', 'auto')
DEFAULT_PROVIDER=demo

# Local Open-Source Ollama Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# Cloud Model Providers (Optional - Zero keys required in Demo Mode)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=

# Database Configuration (SQLite default for local; PostgreSQL supported)
DATABASE_URL=sqlite:///./edurag.db

# Security & JWT Authentication
JWT_SECRET_KEY=edurag_secret_edu_key_super_secure_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
